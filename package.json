{
  "name": "fire-desktop",
  "productName": "Fire Desktop",
  "version": "1.1.0",
  "description": "Desktop-App zur Verwaltung von 24fire KVM-Servern über die FireAPI",
  "main": "src/main.js",
  "author": "Fojadrachi",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "de.fojadrachi.firedesktop",
    "productName": "Fire Desktop",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "afterPack": "build/afterPack.js",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fire Desktop",
      "artifactName": "Fire-Desktop-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Fire-Desktop-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ssh2": "^1.16.0"
  },
  "repository": "https://github.com/fojadrachi/Fire-Desktop"
}